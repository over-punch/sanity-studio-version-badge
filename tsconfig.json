{
	"compilerOptions": {
		"target": "ES2017",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"esModuleInterop": true,
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"jsx": "react-jsx",
		"lib": ["ES2017", "DOM", "DOM.Iterable"]
	},
	"include": ["src"],
	"exclude": ["node_modules", "dist"]
}
