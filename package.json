{
  "name": "@liiift-studio/sanity-studio-version-badge",
  "version": "2.4.1",
  "description": "Sanity Studio plugin — shows installed @liiift-studio package versions in a bottom-right badge on the structure root page.",
  "license": "MIT",
  "author": "Liiift Studio",
  "keywords": [
    "sanity",
    "sanity-plugin",
    "sanity-studio",
    "version",
    "badge"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.*"
  ],
  "scripts": {
    "build": "tsup",
    "capture": "node scripts/capture.mjs",
    "dev": "tsup --watch",
    "link": "npm run build && npm link",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@liiift-studio/sanity-ui-compat": "^0.1.2"
  },
  "peerDependencies": {
    "@sanity/icons": ">=2 <6",
    "@sanity/ui": ">=2 <5",
    "react": ">=18",
    "sanity": ">=3 <7"
  },
  "devDependencies": {
    "@sanity/icons": "^5",
    "@sanity/ui": "^4",
    "@types/react": "^19",
    "react": "^19",
    "sanity": "^5",
    "tsup": "^8",
    "typescript": "^5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Liiift-Studio/sanity-studio-version-badge.git"
  }
}
